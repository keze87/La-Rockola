{
	"name": "la-rockola-del-carpincho",
	"private": true,
	"version": "0.1.0",
	"//": "typescript se mantiene <6.1.0 porque typescript-eslint@8 todavia no soporta TS 7+",
	"type": "module",
	"scripts": {
		"build": "vue-tsc --noEmit && vite build",
		"dev": "vite",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:fix": "eslint . --ext .ts,.vue --fix",
		"lint": "eslint . --ext .ts,.vue --max-warnings 0",
		"preview": "vite preview",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:coverage": "vitest run --coverage",
		"test:watch": "vitest",
		"watch": "vite build --watch",
		"android:sync": "npm run build && python3 scripts/build_android.py --sync-only",
		"android:build": "python3 scripts/build_android.py",
		"android:release": "python3 scripts/build_android.py --release --flavor arm64",
		"android:install": "npm run android:release && (adb get-state >/dev/null 2>&1 && adb install -r android/app/build/outputs/apk/arm64/release/app-arm64-release.apk || echo 'Sin dispositivo adb conectado; omitiendo instalación')"
	},
	"dependencies": {
		"@capacitor/core": "^8.6.2",
		"@floating-ui/vue": "^2.0.1",
		"@headlessui/vue": "^1.7.23",
		"@vueuse/core": "^15.0.0",
		"fuse.js": "^7.5.0",
		"leaflet": "^1.9.4",
		"qrcode.vue": "^3.11.0",
		"vue": "^3.5.44",
		"vue-sonner": "^2.0.9"
	},
	"devDependencies": {
		"@capacitor/android": "^8.6.2",
		"@capacitor/cli": "^8.6.2",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/leaflet": "^1.9.22",
		"@types/node": "^26.6.5",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vitest/coverage-v8": "^5.0.5",
		"@vue/test-utils": "^2.5.1",
		"@vue/tsconfig": "^0.9.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-vue": "^10.12.0",
		"globals": "^17.13.0",
		"happy-dom": "^21.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"tailwindcss": "^4.3.3",
		"typescript": "<6.1.0",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5",
		"vue-tsc": "^3.3.13"
	}
}
