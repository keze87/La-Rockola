<?xml version="1.0" encoding="utf-8"?>
<!--
    En Android, <domain-config> no admite rangos CIDR ni wildcards de IP para redes LAN privadas
    (192.168.x.x, 10.x.x.x, 172.16-31.x.x). El modo Cliente Remoto necesita conectarse por HTTP
    plano a servidores Rockola locales en Wi-Fi sin TLS, por lo que base-config habilita cleartext
    y se explicita localhost / 127.0.0.1 para el servidor embebido.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
