<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="open_library"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_library"
        android:shortcutShortLabel="@string/shortcut_library_short"
        android:shortcutLongLabel="@string/shortcut_library_long">
        <intent
            android:action="ar.carpincho.rockola.ACTION_OPEN_LIBRARY"
            android:targetPackage="ar.carpincho.rockola"
            android:targetClass="ar.carpincho.rockola.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_queue"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_queue"
        android:shortcutShortLabel="@string/shortcut_queue_short"
        android:shortcutLongLabel="@string/shortcut_queue_long">
        <intent
            android:action="ar.carpincho.rockola.ACTION_OPEN_QUEUE"
            android:targetPackage="ar.carpincho.rockola"
            android:targetClass="ar.carpincho.rockola.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_tops"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_tops"
        android:shortcutShortLabel="@string/shortcut_tops_short"
        android:shortcutLongLabel="@string/shortcut_tops_long">
        <intent
            android:action="ar.carpincho.rockola.ACTION_OPEN_TOPS"
            android:targetPackage="ar.carpincho.rockola"
            android:targetClass="ar.carpincho.rockola.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_fogon"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_fogon_short"
        android:shortcutLongLabel="@string/shortcut_fogon_long">
        <intent
            android:action="ar.carpincho.rockola.ACTION_OPEN_FOGON"
            android:targetPackage="ar.carpincho.rockola"
            android:targetClass="ar.carpincho.rockola.MainActivity" />
    </shortcut>
</shortcuts>
